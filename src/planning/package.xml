<?xml version="1.0"?>
<package format="3">
  <name>planning</name>
  <version>0.0.1</version>
  <description>Workspace and whole-arm motion planning for CRA</description>

  <maintainer email="pwindikurniawan@gmail.com">cra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>cra</exec_depend>
  <exec_depend>simulation</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>